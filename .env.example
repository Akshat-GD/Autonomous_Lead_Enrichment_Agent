# --- Ollama (local LLM server) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180

# Cost knobs — leave at 0 for local Ollama. Only set these if you point
# llm_extractor at a paid/hosted endpoint instead.
COST_PER_1K_PROMPT_TOKENS=0.0
COST_PER_1K_COMPLETION_TOKENS=0.0

# --- Crawler ---
MAX_SUBPAGES_PER_DOMAIN=6
PAGE_LOAD_TIMEOUT_MS=25000
REQUEST_DELAY_SECONDS=1.0
HEADLESS=true
SUBPAGE_KEYWORDS=about,about-us,company,team,our-team,leadership,contact,contact-us,pricing,careers,who-we-are

# --- Token budget ---
MAX_CHARS_PER_PAGE=6000
MAX_CHARS_TOTAL_CONTEXT=18000

# --- Output ---
OUTPUT_DIR=output
OUTPUT_JSON_NAME=output.json
OUTPUT_CSV_NAME=output.csv
COST_LOG_NAME=cost_log.csv